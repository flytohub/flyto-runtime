{
  "$id": "https://raw.githubusercontent.com/flytohub/flyto-runtime/main/schema/flyto2.execution.v1/capability-result.schema.json",
  "title": "Flyto2 capability result",
  "description": "Provider-neutral accepted, successful, or failed capability result envelope.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "flyto2.execution.v1"
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "success",
        "failed"
      ]
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "completed_at": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "evidence": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "additionalProperties": false
      }
    },
    "operation": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "running"
          ]
        },
        "wait": {
          "type": "object",
          "properties": {
            "capability": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "input": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "capability",
            "input"
          ],
          "additionalProperties": false
        },
        "inspect": {
          "type": "object",
          "properties": {
            "capability": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "input": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "capability",
            "input"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "ref",
        "state"
      ],
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "retryable": {
          "default": false,
          "type": "boolean"
        },
        "detail": {
          "type": "string",
          "maxLength": 1200
        }
      },
      "required": [
        "code",
        "retryable"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "invocation_id",
    "capability",
    "revision",
    "status",
    "started_at",
    "output",
    "evidence"
  ],
  "additionalProperties": false
}
