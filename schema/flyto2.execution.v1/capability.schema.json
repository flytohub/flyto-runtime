{
  "$id": "https://raw.githubusercontent.com/flytohub/flyto-runtime/main/schema/flyto2.execution.v1/capability.schema.json",
  "title": "Flyto2 Runtime capability descriptor",
  "description": "A versioned capability advertised by a composed Flyto2 Runtime instance.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "default": 1,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "risk_level": {
      "default": "medium",
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "dangerous"
      ]
    },
    "approval": {
      "default": "policy",
      "type": "string",
      "enum": [
        "none",
        "policy",
        "explicit"
      ]
    },
    "evidence": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    }
  },
  "required": [
    "id",
    "revision",
    "risk_level",
    "approval",
    "evidence"
  ],
  "additionalProperties": false
}
