{
  "name": "flyto2-runtime",
  "version": "1.1.0",
  "description": "Give ChatGPT secure access to your machine. Turn ChatGPT into Codex.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flytohub/flyto-runtime.git"
  },
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.19 <27"
  },
  "packageManager": "pnpm@11.25.0",
  "bin": {
    "flyto2-runtime": "bin/devspace.js",
    "devspace": "bin/devspace.js",
    "flyto2-runtime-agentd": "bin/devspace-agentd.js",
    "devspace-agentd": "bin/devspace-agentd.js"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "examples",
    "schema",
    "scripts",
    "skills",
    "README.md",
    "NOTICE.md",
    "Flyto2 Runtime.command",
    "Flyto2 Runtime.cmd",
    "Install.command",
    "Install.cmd"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && tsx scripts/generate-build-info.ts",
    "lint": "tsx scripts/lint-flyto2.ts",
    "dev": "tsx scripts/dev.ts",
    "dev:seed": "tsx scripts/dev-state.ts seed",
    "dev:reset": "tsx scripts/dev-state.ts reset",
    "postinstall": "node scripts/fix-node-pty-permissions.mjs",
    "prepack": "pnpm build",
    "schema:config": "tsx scripts/generate-config-schema.ts",
    "start": "node dist/cli.js serve",
    "test": "tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "test:package-install": "tsx --test --test-concurrency=1 \"test/package-install-smoke.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [],
  "author": "Flyto2 contributors",
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.1.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.200",
    "@anthropic-ai/sandbox-runtime": "0.0.71",
    "@clack/prompts": "^1.5.1",
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opencode-ai/sdk": "1.17.13",
    "better-result": "^2.10.0",
    "better-sqlite3": "^12.10.0",
    "cross-spawn": "^7.0.6",
    "diff": "^8.0.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "jsonc-parser": "^3.3.1",
    "semver": "^7.8.4",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/semver": "^7.7.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "koffi": "^3.1.2",
    "node-pty": "^1.1.0"
  }
}
